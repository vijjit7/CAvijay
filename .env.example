# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/auditguard

# Session Configuration  
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Environment
NODE_ENV=production

# Optional: OpenRouter API for AI features
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Report PDF object storage (Cloudflare R2, S3-compatible) ──────────────────
# When set, report PDFs are stored in the R2 bucket instead of as base64 in the
# Postgres `reports.pdf_content` column, keeping the database small and cheap.
# If unset, the app keeps the legacy inline-base64 behaviour (no change).
# Setup: Cloudflare dashboard → R2 → create a bucket, then create an API token
# (Object Read & Write) to get the access key id/secret. The account id is in the
# R2 overview / endpoint URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=auditguard-reports

# Optional: Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account"...}

# Optional: Google Maps Geocoding — turns an allocated case's address into
# coordinates so the "new work" push can show the distance from the associate's
# device to that address. Enable the "Geocoding API" in Google Cloud and create an
# API key. If unset, notifications simply omit the distance line.
GOOGLE_MAPS_API_KEY=your-google-maps-geocoding-api-key

# ── Gmail → MIS auto-import ────────────────────────────────────────────────
# Reads Piramal "work allocation" emails and adds new work to MIS automatically.
# Setup (one time):
#   1. Google Cloud Console → create an OAuth 2.0 Client ID (type: Web app).
#   2. Add https://developers.google.com/oauthplayground as a redirect URI.
#   3. OAuth Playground → gear icon → use your own client ID/secret →
#      authorize scope: https://www.googleapis.com/auth/gmail.readonly →
#      Exchange authorization code for tokens.
#   4. Paste the resulting token JSON (must include refresh_token) into GMAIL_TOKEN.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_TOKEN={"access_token":"...","refresh_token":"...","scope":"https://www.googleapis.com/auth/gmail.readonly","token_type":"Bearer","expiry_date":0}

# Scheduler (all optional)
# MIS_AUTO_IMPORT_ENABLED=true       # set false to disable background polling
# MIS_AUTO_IMPORT_INTERVAL_MIN=15    # minutes between Gmail checks
# MIS_AUTO_IMPORT_DAYS_BACK=2        # how many days of email each run scans

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/auditguard

# Session Configuration  
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Environment
NODE_ENV=production

# Optional: OpenRouter API for AI features
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account"...}

# ── Gmail → MIS auto-import ────────────────────────────────────────────────
# Reads Piramal "work allocation" emails and adds new work to MIS automatically.
# Setup (one time):
#   1. Google Cloud Console → create an OAuth 2.0 Client ID (type: Web app).
#   2. Add https://developers.google.com/oauthplayground as a redirect URI.
#   3. OAuth Playground → gear icon → use your own client ID/secret →
#      authorize scope: https://www.googleapis.com/auth/gmail.readonly →
#      Exchange authorization code for tokens.
#   4. Paste the resulting token JSON (must include refresh_token) into GMAIL_TOKEN.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_TOKEN={"access_token":"...","refresh_token":"...","scope":"https://www.googleapis.com/auth/gmail.readonly","token_type":"Bearer","expiry_date":0}

# Scheduler (all optional)
# MIS_AUTO_IMPORT_ENABLED=true       # set false to disable background polling
# MIS_AUTO_IMPORT_INTERVAL_MIN=15    # minutes between Gmail checks
# MIS_AUTO_IMPORT_DAYS_BACK=2        # how many days of email each run scans
